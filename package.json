{
  "name": "model-usage-display",
  "displayName": "Model Usage Display",
  "description": "Status bar display of remaining AI model quota (Gemini / Claude / GPT) from Antigravity, with a per-model dashboard and reset-time notifications. Unofficial.",
  "version": "1.2.0",
  "publisher": "hiroomi",
  "license": "MIT",
  "homepage": "https://github.com/hiroomi0910/Model-usage-display#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiroomi0910/Model-usage-display.git"
  },
  "bugs": {
    "url": "https://github.com/hiroomi0910/Model-usage-display/issues"
  },
  "qna": "marketplace",
  "pricing": "Free",
  "keywords": [
    "antigravity",
    "quota",
    "usage",
    "statusbar",
    "gemini",
    "claude",
    "gpt",
    "ai",
    "rate limit"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#141926",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "modelUsageDisplay.showDetails",
        "title": "%command.showDetails.title%"
      },
      {
        "command": "modelUsageDisplay.refresh",
        "title": "%command.refresh.title%"
      }
    ],
    "configuration": {
      "title": "Model Usage Display",
      "properties": {
        "modelUsageDisplay.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "%config.pollIntervalSeconds%"
        },
        "modelUsageDisplay.warnThresholdPercent": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.warnThresholdPercent%"
        },
        "modelUsageDisplay.dangerThresholdPercent": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.dangerThresholdPercent%"
        },
        "modelUsageDisplay.notifyOnThreshold": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyOnThreshold%"
        },
        "modelUsageDisplay.notifyOnReset": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyOnReset%"
        },
        "modelUsageDisplay.hiddenModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.hiddenModels%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.74.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
